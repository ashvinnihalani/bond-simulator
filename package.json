{
  "name": "bond-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive US Treasury market simulator: curve, issuance, auctions, on/off-the-run liquidity, and buybacks.",
  "scripts": {
